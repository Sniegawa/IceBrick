#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba8, binding = 0) uniform writeonly image2D u_OutputImage;

struct Ray
{
    vec3 origin;
    vec3 direction;
};

layout(binding = 1) uniform usampler3D u_VoxelGrid;

layout(std140, binding = 2) uniform SceneDataBuffer
{
    vec4 u_SunDir;
    vec4 u_BackgroundColor;

    vec4 u_CamPos;
    vec4 u_CamFront;
    vec4 u_CamUp;
    vec4 u_CamRight;
    ivec4 debugInfo;
};

layout(std430, binding = 3) writeonly buffer RaycastPickBuffer
{
    ivec3 u_HitCell;
    uint u_HitValid;
    ivec3 u_HitNormal;
    uint u_Pad;
};

uint GetVoxel(ivec3 pos, int lod)
{
    return texelFetch(u_VoxelGrid, pos, lod).r;
}

vec3 UnpackVoxelColor(uint voxelData)
{
    float r = float((voxelData >> 11) & 0x1Fu) / 31.0f;
    float g = float((voxelData >> 6) & 0x1Fu) / 31.0f;
    float b = float((voxelData >> 1) & 0x1Fu) / 31.0f;

    return vec3(r, g, b);
}

bool isVoxelSolid(uint voxelData)
{
    return (voxelData & 1u) != 0u;
}

vec3 DebugHeatmap(uint checks, int threshold)
{
    if (float(checks) >= threshold)
        return vec3(1.0); // Pure white once over budget

    float t = clamp(float(checks) / float(threshold), 0.0, 1.0);

    // Optional: boost low/mid step counts into rich purple/magenta instead of black
    // t = sqrt(t);

    const vec3 stops[8] = vec3[8](
        vec3(0.001, 0.000, 0.014), // Near-black indigo
        vec3(0.114, 0.047, 0.276), // Dark indigo
        vec3(0.320, 0.055, 0.427), // Royal purple
        vec3(0.525, 0.125, 0.415), // Magenta-violet
        vec3(0.735, 0.216, 0.330), // Crimson-coral
        vec3(0.910, 0.376, 0.175), // Fiery orange
        vec3(0.988, 0.645, 0.039), // Glowing amber-yellow
        vec3(0.995, 0.960, 0.680)  // Pale incandescent yellow
    );

    float scaled = t * 7.0;
    int idx = min(int(scaled), 6);
    float frac = scaled - float(idx);

    return mix(stops[idx], stops[idx + 1], frac);
}
void main()
{
    vec2 pixel = vec2(gl_GlobalInvocationID.xy);
    vec2 res = vec2(imageSize(u_OutputImage));

    if(pixel.x >= res.x || pixel.y >= res.y)
        return;

    bool isCenterPixel = all(equal(ivec2(pixel), ivec2(res) / 2));
    if(isCenterPixel)
        u_HitValid = 0u;

    vec2 screenPos = (pixel + 0.5) / res * 2.0 - 1.0;

    float aspectRatio = res.x / res.y;
    screenPos.x *= aspectRatio;

    float fovScale = tan(radians(90) / 2.0);
    screenPos *= fovScale;

    Ray r;
    r.origin = u_CamPos.xyz; 
    r.direction = normalize(
        u_CamFront.xyz +
        (screenPos.x * u_CamRight.xyz) +
        (screenPos.y * u_CamUp.xyz)
    );

    vec3 safeDir = r.direction;
    if(abs(safeDir.x) <0.000001) safeDir.x = (safeDir.x < 0.0) ? -0.000001 : 0.000001;
    if(abs(safeDir.y) <0.000001) safeDir.y = (safeDir.y < 0.0) ? -0.000001 : 0.000001;
    if(abs(safeDir.z) <0.000001) safeDir.z = (safeDir.z < 0.0) ? -0.000001 : 0.000001;

    ivec3 baseDims = textureSize(u_VoxelGrid,0);
    vec3 boxMin = vec3(0.0);
    vec3 boxMax = vec3(baseDims);

    vec3 invDir = 1.0 / safeDir;

    vec3 t0 = (boxMin - r.origin) * invDir;
    vec3 t1 = (boxMax - r.origin) * invDir;

    vec3 tNear = min(t0, t1);
    vec3 tFar = max(t0, t1);

    float tEntry = max(max(tNear.x, tNear.y), tNear.z);
    float tExit = min(min(tFar.x, tFar.y), tFar.z);

    if(tEntry > tExit || tExit < 0.0)
    {
        imageStore(u_OutputImage, ivec2(pixel), u_BackgroundColor);
        return;
    }

    r.origin = r.origin + max(0.0, tEntry) * r.direction;

    ivec3 step = ivec3(sign(r.direction));
    if(step.x == 0) step.x = 1;
    if(step.y == 0) step.y = 1;
    if(step.z == 0) step.z = 1;

    vec3 color = u_BackgroundColor.xyz;
    ivec3 mask = ivec3(0);
    if(tEntry > 0.0)
    {
        mask = ivec3(
                int(tNear.x >= tNear.y && tNear.x >= tNear.z),
                int(tNear.y > tNear.x && tNear.y >= tNear.z),
                int(tNear.z > tNear.x && tNear.z > tNear.y)
                );
    }
    
    // Debug info
    uint checks = 0;

    

    int maxLod = min(9, textureQueryLevels(u_VoxelGrid) - 1);
    int lod = maxLod;
    float t = 0.0;

    ivec3 startDims = max(ivec3(1), baseDims >> lod);
    ivec3 cell = clamp(ivec3(floor(r.origin)) >> lod, ivec3(0), startDims - 1);


    while(true)
    {
        checks++;
        uint voxelData = GetVoxel(cell, lod);

        if(isVoxelSolid(voxelData))
        {
            if(lod == 0)
            { 
                vec3 baseColor = UnpackVoxelColor(voxelData);
                const vec3 lightDir = normalize(u_SunDir.xyz);
                vec3 normal = vec3(mask) * vec3(-step);
                float diffuse = max(dot(normal, lightDir), 0.1);
                color = baseColor * diffuse;

                if(isCenterPixel)
                {
                    u_HitCell = cell;
                    u_HitNormal = ivec3(mask * vec3(-step));
                    u_HitValid = 1u;
                }

                break;
            }

            lod--;
            vec3 pos = r.origin + t * r.direction;
            ivec3 child = ivec3(floor(pos)) >> lod;
            cell = clamp(child, cell * 2, cell * 2 + 1);
            continue;
        }

        float cellSize = float(1 << lod);
        vec3 exitPlane = (vec3(cell) + vec3(greaterThan(step, ivec3(0)))) * cellSize;
        vec3 tPlane = (exitPlane - r.origin) * invDir;

        ivec3 mipDims = max(ivec3(1), baseDims >> lod);
        int oldCoord;
        int newCoord;
        int axisLimit;

        if(tPlane.x < tPlane.y && tPlane.x < tPlane.z)
        {
            t = max(t, tPlane.x);
            oldCoord = cell.x;
            cell.x += step.x;
            newCoord = cell.x;
            axisLimit = mipDims.x;
            mask = ivec3(1, 0, 0);
        }
        else if(tPlane.y < tPlane.z)
        {
            t = max(t, tPlane.y);
            oldCoord = cell.y;
            cell.y += step.y;
            newCoord = cell.y;
            axisLimit = mipDims.y;
            mask = ivec3(0, 1, 0);
        }
        else
        {
            t = max(t, tPlane.z);
            oldCoord = cell.z;
            cell.z += step.z;
            newCoord = cell.z;
            axisLimit = mipDims.z;
            mask = ivec3(0, 0, 1);
        }

        if(newCoord < 0 || newCoord >= axisLimit)
            break;


        // If hit nothing go back to higher LOD
        if(lod < maxLod && (oldCoord >> 1) != (newCoord >> 1))
        {
            lod++;
            cell >>= 1;
        }

    }
    if(isCenterPixel)
        color = vec3(1.0) - color; // dot crosshair

    if(debugInfo.x == 1)
        color = DebugHeatmap(checks,debugInfo.y);

    imageStore(u_OutputImage, ivec2(pixel), vec4(color,1.0));

}
